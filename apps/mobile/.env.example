# Copy to .env.local (not committed). EXPO_PUBLIC_* values are bundled into the
# app, so only public values go here — never secret keys.

# The web app's address as the phone sees it. For a phone on the same Wi-Fi as
# your computer use the computer's LAN IP, e.g. http://192.168.1.20:3000
EXPO_PUBLIC_API_URL=http://192.168.1.20:3000

# Same Clerk instance as the web app: NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY (pk_...)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
