# ─────────────────────────────────────────────────────────────────────────────
# InvoiceGen — environment variables
#
#   cp .env.example .env.local   # then fill in values
#
# Full walkthrough: docs/environment-setup.md
# Minimum to boot: DATABASE_URL, the two Clerk keys, APP_ENCRYPTION_KEY.
# Everything else is optional — features degrade gracefully when unset.
# Never commit .env.local or real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
# Public base URL (used in emails, Stripe redirects, links in PDFs).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# REQUIRED. 32-byte hex key used to encrypt stored SMTP passwords.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=

# ── Database (Neon Postgres) — REQUIRED ──────────────────────────────────────
# Use the *pooled* connection string from the Neon dashboard.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ── Auth (Clerk) — REQUIRED for sign-in ──────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Optional: only needed if you configure a Clerk webhook.
CLERK_WEBHOOK_SECRET=

# ── Billing (Stripe) — optional ──────────────────────────────────────────────
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook endpoint: POST /api/webhooks/stripe
# Local: `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=
# Monthly recurring Price IDs for the paid plans.
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_BUSINESS=

# ── Email (Resend, platform default sender) — optional ───────────────────────
# Users can also configure their own SMTP in Settings.
RESEND_API_KEY=
EMAIL_FROM="InvoiceGen <invoices@yourdomain.com>"

# ── File storage (Cloudflare R2) — optional ───────────────────────────────────
# Public bucket: logos. Private bucket: archived PDFs (client data, never public).
# Setup: docs/environment-setup.md §7
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
# Custom domain (production) or r2.dev URL serving the public bucket, no trailing slash.
R2_PUBLIC_URL=
R2_PRIVATE_BUCKET=

# ── Cron (reminders + overdue marking) — optional ────────────────────────────
# Sent as `Authorization: Bearer $CRON_SECRET` to GET /api/cron/reminders.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# ── Google Calendar integration — optional ───────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
